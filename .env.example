# Copy this file to .env and fill in real keys. .env is gitignored — it never
# gets committed or pushed to GitHub/Overleaf.
#
#   cp .env.example .env   # then edit .env
#
# You only need keys for the providers in your chosen model basket (config.py).

# --- Path X (your existing providers only): need these two ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Path Y (recommended, adds open-weight diversity): also need this ---
# Together serves Llama / Qwen via an OpenAI-compatible endpoint. ~$5 credit
# covers the whole run with room to spare.
TOGETHER_API_KEY=

# --- Optional: Google Gemini (skipped for now; free tier available) ---
GOOGLE_API_KEY=
